# Нормализация переносов строк в репозитории.
# По умолчанию git сам определяет текстовые файлы и хранит их с LF.
* text=auto

# Файлы, которые исполняются ВНУТРИ Linux-контейнеров, обязаны быть с LF,
# иначе шебанг `#!/bin/sh` ломается (ошибка "no such file or directory").
*.sh        text eol=lf
start.sh    text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Бинарные файлы (фото каталога лежат в репозитории) — не трогаем.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
