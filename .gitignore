# ============================================================
#  КупиДон — .gitignore
# ============================================================

# ---------- Секреты / окружение ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Node (frontend / admin) ----------
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
.eslintcache

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------- Базы данных ----------
*.sqlite
*.sqlite3
*.db

# ---------- Загрузки каталога ----------
# Фото каталога хранятся В РЕПОЗИТОРИИ (вариант «фото в git»):
# backend/media/*.jpg|png|webp|gif и manifest.json коммитятся и едут с репо.
# Игнорируем только временные файлы атомарной записи манифеста.
backend/media/*.tmp

# ---------- Логи ----------
*.log
logs/

# ---------- IDE / редакторы ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- ОС ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Личные рабочие файлы (не для репозитория) ----------
правки.txt
ТЗ_строительная_система.md
